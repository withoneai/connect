{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "node",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "resolveJsonModule": true,
    "jsx": "preserve",
    "noEmit": true,
    "declaration": true,
    "removeComments": false,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "importHelpers": true,
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@withone/connect": [
        "src/index.ts"
      ],
      "@withone/connect/server": [
        "src/server/index.ts"
      ],
      "@withone/connect/next": [
        "src/next.ts"
      ],
      "@withone/connect/node": [
        "src/node.ts"
      ]
    },
    "rootDir": "src"
  },
  "include": [
    "src"
  ]
}
